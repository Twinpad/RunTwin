# TwinPad environment configuration — One Launchpad. Two Routes.
# Copy to .env.local and fill in values. NEVER commit real secrets.
# ==============================================================================
# Variable groups:
#   1. Public frontend variables        (NEXT_PUBLIC_* — inlined at BUILD time)
#   2. Server-side private variables    (secrets — never NEXT_PUBLIC_*)
#   3. Solana RPC configuration
#   4. Wallet & transaction configuration (none — wallets sign client-side)
#   5. Pump.fun / PumpPortal live configuration
#   6. Raydium configuration (no keys — public programs + launch-mint API)
#   7. Metadata storage (Pinata IPFS)
#   8. Database configuration
#   9. Official $TWIN treasury dashboard (public addresses only)
#  10. Optional services / tuning
# ==============================================================================
#
# PRODUCTION DEPLOYMENT (non-Vercel hosting):
#   - Node.js >= 20 (package.json engines).
#   - Install with: npm install --legacy-peer-deps
#   - Build with:   npm run build      (next build)
#   - Start with:   npm run start      (next start)
#   - Build must NOT run while `next dev` is running on the same directory:
#     a concurrent build corrupts .next.
#   - Database (choose one):
#     a) PostgreSQL (recommended): point DATABASE_URL at the Postgres
#        connection string, switch the provider in prisma/schema.prisma to
#        "postgresql", run `prisma generate` + `prisma migrate deploy`.
#        Models are identical across providers; see prisma/postgres/.
#     b) SQLite: keep provider "sqlite" and set DATABASE_URL to a file: URL
#        on a PERSISTENT disk (e.g. file:./twinpad.db). Ephemeral disks lose
#        launch records. The runtime bootstraps a missing schema itself.
#   - Run migrations in CI or before start: npm run prisma:migrate
#     (prisma migrate deploy). The prisma CLI is a devDependency, so run
#     migrations before pruning devDependencies.
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. Public frontend variables (inlined at BUILD time)
# ------------------------------------------------------------------------------
# The TwinPad network variable is the ONLY network variable the app reads.
#   "devnet" | "mainnet-beta" — controls the client cluster, program IDs and
#   discovery endpoints. Changing it requires a production REBUILD.
NEXT_PUBLIC_TWINPAD_NETWORK=devnet

# Browser RPC endpoint for wallet connection + the launch flow. Recommended:
# TwinPad's built-in server-side proxy "/api/rpc" (forwards browser JSON-RPC to
# the server-side provider with a strict method allowlist — the API key never
# reaches the browser, and signing stays in the wallet). A dedicated
# browser-safe RPC URL may also be used.
# SECURITY: never put a credentialed URL in a NEXT_PUBLIC_* variable.
NEXT_PUBLIC_SOLANA_RPC_URL=/api/rpc

# App identity
NEXT_PUBLIC_APP_NAME=TwinPad
NEXT_PUBLIC_APP_URL=http://localhost:3000
# Optional (Vercel-only): VERCEL_PROJECT_PRODUCTION_URL is injected by Vercel
# and only refines the SEO/metadata origin there.
# VERCEL_PROJECT_PRODUCTION_URL=

# ------------------------------------------------------------------------------
# 2 + 3. Server-side private variables & Solana RPC configuration
# ------------------------------------------------------------------------------
# Precedence for server-side reads (discovery, reconcile, tx confirmation) and
# browser proxying via /api/rpc:
#   1) ALCHEMY_SOLANA_RPC_URL  (full URL, server-side only)
#   2) ALCHEMY_API_KEY         (URL derived: https://solana-<net>.g.alchemy.com/v2/<key>)
#   3) SOLANA_RPC_URL          (any custom provider)
#   4) public cluster endpoint (heavily rate-limited)
ALCHEMY_API_KEY=
ALCHEMY_SOLANA_RPC_URL=
ALCHEMY_SOLANA_WS_URL=
SOLANA_RPC_URL=

# ------------------------------------------------------------------------------
# 4. Wallet & transaction configuration
# ------------------------------------------------------------------------------
# Intentionally NONE. TwinPad has no custody: the browser wallet (Phantom /
# Solflare) signs every transaction, and the optional mint keypair (standard
# or vanity) lives only in the tab's memory. No server-side signing keys exist
# or are supported — do not add any.

# ------------------------------------------------------------------------------
# 5. Pump.fun / PumpPortal live configuration
# ------------------------------------------------------------------------------
# Trending/live feeds. The keyless PumpPortal tier streams token creations and
# migrations; per-token trade streaming requires an API key funded with at
# least 0.2 SOL worth of credits — otherwise TwinPad sources trades via
# on-chain RPC through the shared gateway. The tier is chosen automatically
# from PUMPPORTAL_API_KEY presence (there is no separate enable switch).
PUMPPORTAL_API_KEY=
PUMP_LIVE_MAX_TOKEN_SUBS=300
PUMPPORTAL_TRADE_POLL_MS=12000
# Optional: cap on RPC calls per discovery/poll round (default 40 in code).
# PUMP_LIVE_ROUND_CALL_BUDGET=40

# ------------------------------------------------------------------------------
# 6. Raydium configuration
# ------------------------------------------------------------------------------
# No credentials. LaunchLab program IDs come from @raydium-io/raydium-sdk-v2
# (devnet/mainnet selected by NEXT_PUBLIC_TWINPAD_NETWORK), and CPMM pool
# discovery uses Raydium's public launch-mint service
# (https://launch-mint-v1.raydium.io). Nothing to configure.

# ------------------------------------------------------------------------------
# 7. Metadata storage (Pinata IPFS — SERVER-SIDE ONLY)
# ------------------------------------------------------------------------------
# Required for artwork/metadata uploads (POST /api/upload). Without it the
# endpoint returns an explicit configuration error — it never fakes success.
PINATA_JWT=
# Optional: dedicated gateway host used to display uploaded assets.
PINATA_GATEWAY=ipfs.io
# NOTE: the artwork upload cap is fixed at 10 MB in code
# (src/lib/metadata.ts, constraints.maxBytes) and is NOT env-configurable.

# ------------------------------------------------------------------------------
# 8. Database configuration (Prisma)
# ------------------------------------------------------------------------------
# Local development default: SQLite file resolved relative to prisma/.
# TwinPad ships with its OWN database file — it never shares FluxPad's data.
DATABASE_URL="file:./twinpad.db"
# Production alternative (switch the provider in prisma/schema.prisma to
# "postgresql" first). NOTE: only prisma/postgres/schema.prisma reads this
# variable; the application itself always reads DATABASE_URL.
POSTGRES_DATABASE_URL=

# ------------------------------------------------------------------------------
# 9. Official $TWIN treasury dashboard (SERVER-SIDE ONLY — public data)
# ------------------------------------------------------------------------------
# Read-only /treasury dashboard for a future official $TWIN token. Public
# addresses and non-secret policy values only. All values are placeholders
# until the owner finalizes them; unset values render honest "configuration
# needed" states. NEVER put private keys or signing credentials here or in
# any NEXT_PUBLIC_* variable.
TWINPAD_OFFICIAL_ENABLED=
# Network override; falls back to NEXT_PUBLIC_TWINPAD_NETWORK when unset.
TWINPAD_OFFICIAL_NETWORK=
# W1 — official $TWIN creator-fee receiver (permanent fee recipient).
TWINPAD_OFFICIAL_CREATOR_WALLET=
# W2 — dedicated buyback treasury.
TWINPAD_OFFICIAL_BUYBACK_TREASURY=
# W3 — operations & reserve treasury.
TWINPAD_OFFICIAL_OPS_TREASURY=
# W4 — separate development wallet (transparency listing only).
TWINPAD_OFFICIAL_DEV_WALLET=
# Official $TWIN mint address (after launch; verified on-chain).
# Deliberately left empty until a VERIFIED $TWIN mint exists — no placeholder
# address is ever substituted. $TWIN is a branding concept only; TwinPad does
# not create or deploy it.
TWINPAD_OFFICIAL_MINT=

# ------------------------------------------------------------------------------
# 10. Optional services / tuning
# ------------------------------------------------------------------------------
# Shared RPC gateway (server-side Solana request management): token-bucket
# throttling, bounded concurrency, duplicate coalescing, short-TTL read
# caching, 429 backoff honoring Retry-After with jitter, and a circuit
# breaker. Defaults are tuned for a single Alchemy key.
# RPC_GATEWAY_RATE_RPS=8
# RPC_GATEWAY_BURST=16
# RPC_GATEWAY_CONCURRENCY=6
# RPC_GATEWAY_OPEN_BASE_MS=15000
# Optional: serve-cached-after age cap and separate limits for keyless
# (public-endpoint) operation. All have code defaults; tune only if needed.
# RPC_GATEWAY_STALE_MAX_MS=20000
# RPC_GATEWAY_PUBLIC_RPS=3
# RPC_GATEWAY_PUBLIC_BURST=8
# RPC_GATEWAY_PUBLIC_CONCURRENCY=3
